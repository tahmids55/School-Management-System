# Copy this file to .env before running docker compose:
#   cp .env.example .env
#
# IMPORTANT: Replace JWT_SECRET and all placeholder passwords in .env.
# The prod profile rejects the placeholder JWT_SECRET at startup.

# Host port mapped to PostgreSQL's container port 5432
DB_PORT=5433

# PostgreSQL database name and credentials
DB_NAME=school
DB_USERNAME=school_user
DB_PASSWORD=replace-with-strong-db-password

# HMAC-SHA256 signing key for JWTs (must be at least 32 bytes; placeholder is rejected in prod).
# Generate one with:
#   Linux/macOS: openssl rand -base64 48
#   PowerShell:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=replace-with-random-secret-before-prod-at-least-32-chars

# Initial ADMIN account password (username: admin)
ADMIN_PASSWORD=replace-with-admin-password

# Password used for seeded demo accounts when SEED_DEMO_DATA=true
DEMO_PASSWORD=replace-with-demo-password

# Optional monitoring profile (docker compose --profile monitoring up --build)
# Default stack starts without these; /actuator/prometheus stays closed when unset.
METRICS_USERNAME=prometheus
METRICS_PASSWORD=replace-with-metrics-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-password
